{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "backend: test-compile",
      "type": "shell",
      "command": "npm run test:compile",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "backend: bật DB test (docker)",
      "type": "shell",
      "command": "docker compose -f compose.test.yml up -d",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "mobile: pub get",
      "type": "shell",
      "command": "flutter pub get",
      "options": { "cwd": "${workspaceFolder}/mobile" },
      "problemMatcher": []
    },
    {
      "label": "mobile: test",
      "type": "shell",
      "command": "flutter test",
      "options": { "cwd": "${workspaceFolder}/mobile" },
      "problemMatcher": []
    }
  ]
}

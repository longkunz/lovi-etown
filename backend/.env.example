# =======================================================
# Camera Backend A1 - Environment Variables Template
# =======================================================

# Server Binding
PORT=3000
HOST=127.0.0.1

# PostgreSQL + PostGIS Connection
DATABASE_URL=postgres://postgres:postgres_test_password@127.0.0.1:5433/camera_catalog_test

# Authentication Keys (Must be at least 32 characters and NOT identical)
BACKEND_API_KEY=test-reader-key-32charslong!!
ADMIN_API_KEY=test-admin-key-32charslong!!
# Optional: previous reader key, accepted on reader routes only while a key
# rotation window is open (T06-D3). Must differ from both keys above.
# BACKEND_API_KEY_PREVIOUS=your-previous-reader-key-at-least-32-chars

# Provider Configuration: 'notis' (default production) or 'fixture' (offline test)
CAMERA_PROVIDER_MODE=notis
NOTIS_AUTH_TOKEN=

# Safety & Rate Limits
BODY_LIMIT_BYTES=65536
SNAPSHOT_MAX_BYTES=2097152
SNAPSHOT_CACHE_MAX_BYTES=33554432
SNAPSHOT_TTL_MS=3000
UPSTREAM_TIMEOUT_MS=5000
MAX_CONCURRENT_UPSTREAM_FETCHES=4
MAX_QUEUED_UPSTREAM_FETCHES=32
RATE_LIMIT_MAX_PER_MINUTE=120
CATALOG_STALE_AFTER_MS=86400000
DEFAULT_REFRESH_INTERVAL_MS=12000

{
  "name": "camera-backend",
  "version": "1.0.0",
  "description": "Camera backend catalog and snapshot service",
  "private": true,
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:unit": "npm run test:compile && node scripts/run-tests.js unit",
    "test:api": "npm run test:compile && node scripts/run-tests.js api",
    "test:db": "npm run test:compile && node scripts/run-tests.js db",
    "db:migrate": "npm run build && node dist/src/cli/migrate.js",
    "seed:fixture": "npm run build && node dist/src/cli/seed-fixture.js",
    "camera:sync": "npm run build && node dist/src/cli/sync.js",
    "camera:probe": "npm run build && node dist/src/cli/probe-availability.js",
    "smoke:notis": "npm run test:compile && node .test-dist/test/smoke/notis-smoke.js",
    "start": "node dist/src/main.js",
    "dev": "npm run build && node dist/src/main.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "dotenv": "18.0.7",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "undici": "8.12.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}

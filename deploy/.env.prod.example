# Copy to .env.prod on the VPS and fill REAL values. Never commit .env.prod.
# Every secret here is environment-specific (T08 AC: no sample secrets in prod).

# Public domain pointing at the VPS, e.g. api.example.com
DOMAIN=api.example.com

# Database (compose-internal). Use a long random password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=camera_catalog

# API keys: at least 32 random characters each, all different (T06-D1/D3).
BACKEND_API_KEY=change-me-reader-key-at-least-32-chars
ADMIN_API_KEY=change-me-admin-key-at-least-32-chars
# BACKEND_API_KEY_PREVIOUS=only-during-a-rotation-window

# Camera provider: 'notis' for the real catalog, 'fixture' for offline checks.
CAMERA_PROVIDER_MODE=notis
NOTIS_AUTH_TOKEN=change-me-notis-token

# T06-D2: requests per minute per (key + IP).
RATE_LIMIT_MAX_PER_MINUTE=120

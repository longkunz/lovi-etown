# Camera Mobile A1 Environment Configuration
# Copy to .env; loaded automatically. --dart-define overrides individual values.
CAMERA_API_BASE_URL=https://api.capyai.site
CAMERA_READER_KEY=your_reader_api_key_here
CAMERA_DEMO_MODE=false
# Google Maps Platform API Key for Traffic Layer and Map Views (T18)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
